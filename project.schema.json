{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatGPT Video Project",
  "type": "object",
  "required": ["title", "video", "voicevox", "scenes"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "video": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 320, "maximum": 3840},
        "height": {"type": "integer", "minimum": 240, "maximum": 2160},
        "fps": {"type": "integer", "minimum": 1, "maximum": 60},
        "background": {"type": "string"}
      }
    },
    "voicevox": {
      "type": "object",
      "required": ["speaker", "speaker_name"],
      "properties": {
        "speaker": {"type": "integer", "minimum": 0},
        "speaker_name": {"type": "string", "minLength": 1},
        "speed_scale": {"type": "number", "minimum": 0.5, "maximum": 2.0}
      }
    },
    "subtitles": {"type": "object"},
    "bgm": {"type": "object"},
    "credits": {"type": "array", "items": {"type": "string"}},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "narration"],
        "properties": {
          "type": {"enum": ["title", "diagram", "image", "clip"]},
          "narration": {"type": "string", "minLength": 1},
          "duration": {"oneOf": [{"const": "auto"}, {"type": "number", "minimum": 0.5}]},
          "path": {"type": "string"},
          "fit": {"enum": ["contain", "cover"]},
          "trim_start": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}

